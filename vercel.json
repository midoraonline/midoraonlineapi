{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.12",
        "maxDuration": 60,
        "memory": 1024
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "main.py" }
  ],
  "crons": [
    {
      "path": "/api/v1/moderation/drain",
      "schedule": "* * * * *"
    }
  ]
}
