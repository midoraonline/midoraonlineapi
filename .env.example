# Supabase (cloud) – Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT signing (REQUIRED in production; must be long + random)
APP_JWT_SECRET=CHANGE_ME_IN_PROD
APP_JWT_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=15
APP_REFRESH_TOKEN_EXPIRE_DAYS=30

# Deployment environment: development | production | test
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins (REQUIRED in production)
# Example: https://www.midoraonline.com,https://midoraonline.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email (SMTP)
Email=
Email_Password=
# Where to send internal "new shop submitted" notifications (comma-separated).
# Leave blank to fall back to the SMTP sender (above), i.e. email yourself.
ADMIN_NOTIFICATION_EMAIL=

# Public URLs used in outbound emails and OAuth redirects
API_BASE_URL=http://localhost:8000
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:3000/auth/verify-email

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback

# AI
Gemini_API_Key=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Listing moderation (Vercel cron + inline pipeline)
# REQUIRED in production so Vercel's cron drain can call the moderation
# endpoint. Any non-empty random string; Vercel injects it into the
# `Authorization: Bearer <CRON_SECRdET>` header automatically.
CRON_SECRET=
# When enabled, POST /shops/{id}/products runs the moderation pipeline
# inline (adds latency to the request but delivers a real status before
# the response). Turn OFF only if you'd rather rely purely on the cron
# drain.
MODERATION_INLINE_ON_ENQUEUE=true
# Max wall-clock allowed for the inline pipeline. Must be lower than the
# Vercel function `maxDuration` (see vercel.json) minus a safety buffer.
MODERATION_INLINE_TIMEOUT=25
# Fail-open when Gemini/OpenAI can't score (keyword + phash checks passed).
MODERATION_FAIL_OPEN_WHEN_MODEL_UNAVAILABLE=true
# Free OpenAI omni-moderation failover (only used when Gemini can't score).
# OPENAI_API_KEY=

# Admin (REQUIRED in production)
ADMIN_API_KEY=

# Africa's Talking — SMS only (account phone verification)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
# Registered short code / alphanumeric sender for SMS. Optional in sandbox.
AFRICASTALKING_SENDER_ID=

# Web Push (VAPID) — URL-safe base64, NOT PEM.
# Public key ≈ 87 chars (applicationServerKey). Private ≈ 43 chars (raw EC).
# PEM is accepted by the API and converted at runtime, but base64 is preferred.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:ops@example.com

# Pesapal (optional — leave blank unless integrating payments)
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# pesapal_ipn_url=

# WhatsApp Business Cloud API — sends the shop WhatsApp number OTP.
# WHATSAPP_MESSAGE_TEMPLATE must be an approved AUTHENTICATION template with a copy-code button.
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account id; used by the admin connection check to read template status.
WHATSAPP_MESSAGING_ACCOUNT_ID=
WHATSAPP_MESSAGE_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
