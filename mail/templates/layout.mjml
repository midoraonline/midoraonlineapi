<mjml>
  <mj-head>
    <mj-title>$title</mj-title>
    <mj-preview>$preview</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.6" color="#1f2937" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-style inline="inline">
      .muted { color: #64748b; font-size: 13px; line-height: 1.55; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f6f7f9">
    <mj-section padding="24px 20px 8px 20px">
      <mj-column>
        <mj-image src="$logo_url" alt="Midora" width="130px" align="center" padding="0" />
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="18px" padding="32px 36px">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#0f172a" padding-bottom="12px">
          $title
        </mj-text>
        <mj-text>
          $content
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px">
      <mj-column>
        <mj-text align="center" css-class="muted">
          You're receiving this message from Midora Online. Questions? Just reply to this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
