<mjml>
  <mj-head>
    <mj-title>Your Midora verification code</mj-title>
    <mj-preview>Your code is $code. It expires in 10 minutes.</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.6" color="#1f2937" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-style inline="inline">
      .muted { color: #64748b; font-size: 13px; line-height: 1.55; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f6f7f9" css-class="em-body">
    <mj-section padding="24px 20px 8px 20px">
      <mj-column>
        <mj-raw>
          <div style="text-align:center;"><img class="em-logo-light" src="$logo_url" alt="Midora" width="130" style="width:130px;height:auto;border:0;display:inline-block;" /><!--[if !mso]><!--><img class="em-logo-dark" src="$dark_logo_url" alt="Midora" width="130" style="width:130px;height:auto;border:0;display:none;max-height:0;overflow:hidden;" /><!--<![endif]--></div>
        </mj-raw>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="18px" padding="32px 36px" css-class="em-card">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#0f172a" padding-bottom="8px">
          Verify your email
        </mj-text>
        <mj-text padding-bottom="20px">
          Enter this code on Midora to confirm your email address.
        </mj-text>
        <mj-text align="center" font-size="34px" font-weight="700" letter-spacing="10px" color="#D4653C"
          container-background-color="#fdf2ec" css-class="em-code" padding="18px 0">
          $code
        </mj-text>
        <mj-spacer height="20px" />
        <mj-text css-class="muted">
          The code expires in 10 minutes. If you didn't ask for it, you can ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px">
      <mj-column>
        <mj-text align="center" css-class="muted">
          Never share this code. Midora will never ask for it by phone or WhatsApp.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
